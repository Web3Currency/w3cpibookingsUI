{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/pibooking",
    "build": "npm run build --workspace=@workspace/pibooking && npm run build --workspace=@workspace/api-server",
    "lint": "tsc --build",
    "typecheck": "tsc --build",
    "start": "npm run build && npm run start --workspace=@workspace/api-server"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true
  }
}
